# ---------------------------------------------------------------- server ----
PORT=8890
# Stamped into every realtime frame this service publishes, so a frame can be
# traced to the process that emitted it. Set by the orchestrator in practice.
POD_NAME=

# -------------------------------------------------------------- postgres ----
# entity_token lives here, along with the permission grants that authorize it.
# DATABASE_URL wins when set; otherwise these are assembled, matching
# worker_service.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ----------------------------------------------------------------- mongo ----
# conversations, messages and notifications.
#
# MONGODB_URI overrides the assembled mongodb+srv:// string entirely. Needed
# for a local or containerised mongod, which has no SRV DNS records; leave it
# empty against Atlas.
MONGODB_URI=
MONGODB_CLUSTER_HOST=
MONGODB_CLUSTER_USER=
MONGODB_CLUSTER_PASS=
MONGODB_DB=chatterloop

# ----------------------------------------------------------------- redis ----
# The platform's realtime bus. This service subscribes to events_<entity_id>
# for streaming, and publishes to it when a message is sent.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# -------------------------------------------------------------- rabbitmq ----
# Fan-out jobs the Go worker already consumes: send_push, bump_chat_score,
# update_ranking_score and bump_interest_affinity. The last two are published
# when a comment is created, so a bot's comment moves the same counters a
# person's does.
#
# Leave empty in development and these are logged as dropped rather than sent -
# which means comment counts and interest affinity silently do not move.
RABBITMQ_URL=
RABBITMQ_PROTOCOL=amqp
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASS=
RABBITMQ_VHOST=

# ------------------------------------------------------------------- sse ----
# A comment line every N seconds keeps an idle stream from being reaped by a
# proxy, and lets a client tell a quiet connection from a dead one.
SSE_HEARTBEAT_SECONDS=20
# Hard ceiling on one stream. Clients reconnect; unbounded connections leak.
SSE_MAX_LIFETIME_SECONDS=3600
